# Caddyfile für den Homeserver: Spielekiste + Konten/Spielstand-Server
# Normales Caddy reicht (kein Zusatzmodul). Der Spielstand-Server muss daneben laufen (siehe LIESMICH.md).

spielkiste.duckdns.org {
	# Komprimieren: die App lädt etwa halb so viele Daten
	encode zstd gzip

	# Konten und Spielstände
	handle /api/* {
		reverse_proxy 127.0.0.1:8090
	}

	# Die App selbst
	handle {
		root * C:/homeserver/spiel
		file_server
	}
}
